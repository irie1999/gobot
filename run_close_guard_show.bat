@echo off
rem ── 手動確認用: 引け前ガードを実行し、結果画面をキー入力まで必ず保持する ──
rem ダブルクリックで実行 → 実行結果(エラー含む)を表示したまま、キーを押すまで閉じない。
rem ※タスクスケジューラには run_close_guard.bat の方を登録すること(こちらは手動専用)。
cd /d "%~dp0"

rem run_close_guard.bat を呼び出す(中で python 解決まで行う)。
rem 中でエラー終了(exit /b)しても call なので戻ってきて、必ず下の pause に到達する。
call "%~dp0run_close_guard.bat"

echo.
echo ============================================================
echo  実行が完了しました(上の内容を確認してください)。
echo  このウィンドウを閉じるには何かキーを押してください。
echo ============================================================
pause >nul
